# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
venv/

# ── Build artifacts ───────────────────────────────────────
build/
dist/
*.zip
*.profraw

# ── Large engine data (see analyzer/README.txt for links) ─
*.nnue

# ── Generated caches / local tools ────────────────────────
openings/*.cache.json
.claude/

# ── Databases ─────────────────────────────────────────────
# The live database lives in ~/.chess_arena (see core.utils.get_db_path)
# and grows without limit as games are imported — it must never be
# committed. Any stray copy in the repo is ignored too.
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3
*.pgn
*.pgn.gz
